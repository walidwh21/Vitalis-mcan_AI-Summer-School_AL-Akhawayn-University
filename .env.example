# Copy to .env and fill in the blanks:  cp .env.example .env

# --- Database -----------------------------------------------------------
POSTGRES_USER=vitalis
POSTGRES_PASSWORD=
POSTGRES_DB=vitalis

# --- Secrets (generate with: openssl rand -hex 32) ----------------------
# Signs and verifies user tokens. Must be >= 32 characters.
JWT_SECRET=
# Shared by chat-service and habits-service for internal calls. >= 16 characters.
INTERNAL_API_KEY=
JWT_EXPIRES_IN=7d

# --- AI chatbot ---------------------------------------------------------
# anthropic | openai | mock
#   anthropic : Anthropic Messages API
#   openai    : any OpenAI-compatible API (OpenAI, OpenRouter, Ollama, vLLM, ...)
#   mock      : offline canned replies, no key needed (not an AI)
AI_PROVIDER=anthropic
# Leave empty to run with the offline mock provider.
AI_API_KEY=
# Optional. Defaults: claude-sonnet-5-5 (anthropic), gpt-4o-mini (openai).
AI_MODEL=
# Optional. Use for proxies or local servers, e.g. http://host.docker.internal:11434/v1
AI_BASE_URL=
AI_MAX_TOKENS=600

# --- Gateway ------------------------------------------------------------
# Only needed if the browser calls the gateway directly from another origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
